{
  "name": "CRM_ML Development Environment",
  "build": {
    "dockerfile": "./Dockerfile",
    "context": ".."
  },

  "features": {
    "ghcr.io/devcontainers/features/common-utils:2": {
      "installZsh": true,
      "installOhMyZsh": true
    }
  },

  "remoteUser": "root",

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-vscode.cpptools",
        "ms-vscode.cmake-tools",
        "ms-python.python",
        "ms-python.vscode-pylance",
        //"ms-vscode.cpptools-extension-pack",
        "openai.chatgpt",
        "anthropic.claude-code",
        "google.geminicodeassist",
        "Google.gemini-cli-vscode-ide-companion"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/usr/bin/python3",
        "cmake.configureOnOpen": false,
        "C_Cpp.default.includePath": [
          "${workspaceFolder}/src",
          "${workspaceFolder}/numerical",
          "/usr/include/eigen3"
        ]
      }
    }
  },

  "mounts": [
  // "source=vscode-server-${devcontainerId},target=/root/.vscode-server,type=volume",

  "source=${localEnv:HOME}/.claude,target=/root/.claude,type=bind,consistency=cached",
  "source=${localEnv:HOME}/.config/claude,target=/root/.config/claude,type=bind,consistency=cached",

  // Use the host VS Code server as the container's server
  "source=${localEnv:HOME}/.vscode-server,target=/root/.vscode-server,type=bind,consistency=cached",

  "source=${localEnv:HOME}/.codex,target=/root/.codex,type=bind,consistency=cached",
  "source=${localEnv:HOME}/.gemini,target=/root/.gemini,type=bind,consistency=cached",

  "source=${localEnv:HOME}/.cache/cloud-code,target=/root/.cache/cloud-code,type=bind,consistency=cached",
  "source=${localEnv:HOME}/.cache/google-vscode-extension,target=/root/.cache/google-vscode-extension,type=bind,consistency=cached"
  ],

  "postCreateCommand": "pip3 install -r requirements.txt && cd build && cmake -DBUILD_PYTHON_BINDINGS=ON .. && make -j$(nproc)",

  "containerEnv": {
    "PYTHONPATH": "/workspaces/CRM_ML"
  }
}
